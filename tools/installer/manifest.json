{
  "format": 1,
  "product": "Mentis",
  "builds": {
    "fluid": {
      "cwd": "apps/fluid-web",
      "steps": [["npm", "ci"], ["npm", "run", "build"]]
    }
  },
  "payload": [
    {"from": "mentis", "to": "app/mentis"},
    {"from": "tools/ladder_vocabulary.py", "to": "app/tools/ladder_vocabulary.py"},
    {"from": "tools/mcp_bridge.py", "to": "app/tools/mcp_bridge.py"},
    {"from": "tools/installer/launcher.py", "to": "app/launcher.py"},
    {"from": "tools/installer/manifest.json", "to": "app/manifest.json"},
    {
      "from": "apps/fluid-web/dist",
      "to": "app/apps/fluid-web/dist",
      "built_by": "fluid",
      "must_hold": ["index.html", "render-check.js", "build-identity.json"]
    }
  ],
  "ports": {"port": 0},
  "launch": [
    {
      "name": "server",
      "command": ["{python}", "-I", "-X", "utf8", "-m", "mentis.web", "{brain}",
                  "--host", "127.0.0.1", "--port", "{port}",
                  "--workspace", "{workspace}", "--mars", "{mars}"],
      "ready": "http://127.0.0.1:{port}/api/server"
    }
  ],
  "open": "http://127.0.0.1:{port}/"
}
